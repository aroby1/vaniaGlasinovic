# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
desktop.ini

# claude code (local tooling/config, not app code — kept on disk, not pushed)
.claude/

# impeccable design linter (local tooling, not app code)
.impeccable/

# AI workflow / product docs (kept locally for context, not part of the deployed app)
CLAUDE.md
PRODUCT.md
DESIGN.md

# superseded/unused drafts, kept locally only
/mockup/
/archive/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
